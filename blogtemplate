  <link rel="stylesheet" href="src/styles.css" />

  <!-- Optional: if you ever want a slightly nicer long-read width without touching global CSS -->
  <style>
    .post {
      max-width: 860px;
      margin: 0 auto;
    }
    .post .muted { line-height: 1.7; }
    .post .content { line-height: 1.85; }
    .post .content h2 { margin-top: 28px; }
    .post .content p { margin: 14px 0; }
  </style>
</head>

<body>

  <!-- Background -->
  <div class="bg" aria-hidden="true">
    <canvas id="webgl"></canvas>
    <div class="grain"></div>
    <div class="glow glow-a"></div>
    <div class="glow glow-b"></div>
  </div>

  <!-- Scroll progress -->
  <div class="progress" aria-hidden="true"><span id="progressBar"></span></div>

  <!-- HEADER -->
  <header class="header">
    <div class="container nav">
      <a class="brand" href="./" aria-label="Home">
        <span class="brand-dot"></span>
        <span class="brand-text">RIKHI</span>
      </a>

      <nav class="links" aria-label="Primary">
        <a href="projects.html">Projects</a>
        <a href="blog.html" aria-current="page">Blog</a>
        <a href="writing.html">Writing</a>
        <a href="speaking.html">Speaking</a>
        <a href="resume.html">Resume</a>
        <a href="contact.html">Contact</a>
      </nav>

      <div class="nav-actions">
