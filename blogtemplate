    <div class="muted tiny">© <span id="year"></span> Rikhi Arindam Gayary</div>
    <div class="row">
      <a class="muted tiny" href="https://github.com/rikhi20" target="_blank" rel="noreferrer">GitHub</a>
      <a class="muted tiny" href="https://www.linkedin.com/in/rikhi20/" target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
  </footer>

  <script type="module" src="src/app.js"></script>
