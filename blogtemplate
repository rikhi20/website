      <a href="contact.html" class="drawer-link">Contact</a>

      <a class="pill wide" href="contact.html">Let’s build</a>
    </div>
  </div>

  <!-- MAIN -->
  <main class="section">
    <div class="container post">

      <!-- Top row -->
      <div class="row" style="justify-content: space-between; align-items: flex-end; gap: 14px;">
        <div>
          <a class="muted tiny" href="blog.html" style="text-decoration:none;">← Back to Blog</a>

          <!-- 1) EDIT: Title -->
          <h1 class="title" style="margin:10px 0 0;">POST TITLE</h1>

          <!-- Optional: date / reading time -->
          <div class="muted tiny" style="margin-top:10px;">
            <span>Feb 26, 2026</span>
            <span style="opacity:.5;">•</span>
            <span>5 min read</span>
          </div>

          <!-- 2) EDIT: Description -->
          <p class="muted" style="margin:14px 0 0;">
            Short post description / teaser goes here.
          </p>
        </div>

        <!-- Optional CTA -->
        <div class="row" style="justify-content:flex-end;">
          <a class="pill tiny" href="contact.html">Contact</a>
        </div>
      </div>

      <div style="height:18px"></div>

      <!-- CONTENT -->
      <article class="card reveal">
        <div class="content">

          <!-- 3) EDIT: Content -->
          <p>
            Start writing here. Keep it simple: paragraphs, headings, lists, code snippets.
          </p>

